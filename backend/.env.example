# Application Settings
APP_NAME=LearnTogether
APP_ENV=development
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (Default: SQLite for zero-config run, or use PostgreSQL)
DATABASE_URL=sqlite:///./learntogether.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/learntogether_db

# Security & Session JWT
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Single Sign-On (SSO) Configuration
# Set to 'true' to enable instant local mock SSO buttons (Alice, Bob, Charlie)
DEV_SSO_ENABLED=true

# Google OAuth 2.0 SSO (Optional: fill when deploying with real Google SSO)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback/google

# Microsoft Entra ID (Azure AD) SSO (Optional: fill when deploying with Azure SSO)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback/microsoft
